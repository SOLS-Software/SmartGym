// Avaliacao fisica do aluno. Cada linha e uma medicao datada — a serie
// ordenada por dtAvaliacao e a curva de evolucao que o aluno ve.
//
// Unidades (fixas, sem coluna de unidade: converter na entrada e comparar
// medicao com medicao e o que faz a serie ter sentido):
//   vlAltura em METROS, vlPeso e vlMassaMagra em QUILOS, circunferencias em
//   CENTIMETROS, vlPercentualGordura em PONTOS PERCENTUAIS (18.5 = 18,5%).
// IMC NAO e coluna: e peso/altura², derivado na leitura para nao existir como
// dado que pode discordar das colunas que o originam.
model AlunoEvolucao {
  id                  Int       @id @default(autoincrement())
  idAluno             Int
  idFuncionario       Int?
  // Foto da avaliacao (antes/depois). Reaproveita AlunoArquivo: o upload passa
  // pelo mesmo fluxo de arquivos do aluno (Supabase + URL assinada), entao a
  // foto ja nasce com validacao de MIME/magic bytes e controle de tenant.
  idAlunoArquivo      Int?
  // Data da MEDICAO, que nem sempre e a do lancamento no sistema (avaliacao de
  // sexta digitada na segunda). A serie temporal ordena por esta coluna.
  dtAvaliacao         DateTime? @db.Date
  vlAltura            Decimal?  @default(0) @db.Decimal(5, 2)
  vlPeso              Decimal?  @default(0) @db.Decimal(5, 2)
  vlPercentualGordura Decimal?  @db.Decimal(5, 2)
  vlMassaMagra        Decimal?  @db.Decimal(5, 2)
  vlCircPeitoral      Decimal?  @db.Decimal(5, 2)
  vlCircCintura       Decimal?  @db.Decimal(5, 2)
  vlCircQuadril       Decimal?  @db.Decimal(5, 2)
  vlCircBraco         Decimal?  @db.Decimal(5, 2)
  vlCircCoxa          Decimal?  @db.Decimal(5, 2)
  dsObservacao        String?   @db.VarChar(1000)
  dtCadastro          DateTime  @default(now())
  dtAlteracao         DateTime  @updatedAt
  idUsuarioCadastro   Int?
  idUsuarioAlteracao  Int?
  boInativo           Boolean   @default(false)

  aluno        Aluno         @relation(fields: [idAluno], references: [id])
  funcionario  Funcionario?  @relation(fields: [idFuncionario], references: [id])
  alunoArquivo AlunoArquivo? @relation(fields: [idAlunoArquivo], references: [id])

  @@index([idAluno])
  @@index([idFuncionario])
  @@index([idAlunoArquivo])
  @@map("tb_AlunoEvolucoes")
}

// Perfil de acesso: o conjunto de permissoes que um funcionario carrega.
// Pertence ao CLIENTE (rede), nao a filial — o mesmo perfil "Recepcao" vale em
// todas as unidades, e um cliente nunca enxerga nem altera o perfil do outro.
//
// Por que nao reaproveitar Cargo: Cargo e uma tabela GLOBAL (sem coluna de
// tenant), compartilhada por todos os clientes e mutavel so pelo super admin.
// Amarrar permissao nela significaria um cliente renomeando um cargo e mudando
// o acesso de todos os outros.
model PerfilAcesso {
  id                 Int      @id @default(autoincrement())
  idCliente          Int
  dsPerfil           String   @default("") @db.VarChar(100)
  // Perfis semeados para todo cliente novo (Recepcao, Professor, Financeiro,
  // Gerente). As permissoes sao editaveis como as de qualquer outro; a marca
  // existe para nao deixar o cliente ficar sem nenhum perfil por engano.
  boPadrao           Boolean  @default(false)
  dtCadastro         DateTime @default(now())
  dtAlteracao        DateTime @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean  @default(false)

  cliente      Cliente                 @relation(fields: [idCliente], references: [id])
  permissoes   PerfilAcessoPermissao[]
  funcionarios Funcionario[]

  @@unique([idCliente, dsPerfil])
  @@index([idCliente])
  @@map("tb_PerfisAcesso")
}

// Uma permissao concedida a um perfil. Linha presente = concedida; ausente =
// negada (deny-by-default, igual ao RBAC do aluno).
model PerfilAcessoPermissao {
  id             Int      @id @default(autoincrement())
  idPerfilAcesso Int
  // Chave do catalogo em apps/api/src/plugins/permissions.ts (ex.:
  // 'students.write'). Texto e nao FK de proposito: o catalogo e CODIGO,
  // versionado junto com o mapa de rotas que ele protege. Uma tabela de
  // permissoes editavel no banco divergiria das rotas na primeira alteracao.
  cnPermissao    String   @db.VarChar(60)
  dtCadastro     DateTime @default(now())

  perfilAcesso PerfilAcesso @relation(fields: [idPerfilAcesso], references: [id], onDelete: Cascade)

  @@unique([idPerfilAcesso, cnPermissao])
  @@index([idPerfilAcesso])
  @@map("tb_PerfilAcessoPermissoes")
}

model AlunoPlano {
  id                   Int       @id @default(autoincrement())
  idAluno              Int
  idPlano              Int
  idPromocaoPlano      Int?
  // Por que o aluno saiu. Preenchido no cancelamento, junto de dtEncerramento.
  // O motivo e uma LOOKUP (e nao so texto livre) porque o valor do dado esta em
  // somar: "7 sairam por preco" muda decisao, "sete frases diferentes" nao.
  // O texto livre fica em dsMotivoCancelamento, para o caso especifico.
  idMotivoCancelamento Int?
  dsMotivoCancelamento String?   @db.VarChar(255)
  nrDiaPagamento       Int       @default(1)
  qtParcelas           Int       @default(1)
  dtAdmissao           DateTime? @default(now())
  dtVencimento         DateTime?
  dtEncerramento       DateTime?
  dtCadastro           DateTime  @default(now())
  dtAlteracao          DateTime  @updatedAt
  idUsuarioCadastro    Int?
  idUsuarioAlteracao   Int?
  boInativo            Boolean   @default(false)

  aluno              Aluno               @relation(fields: [idAluno], references: [id])
  plano              Plano               @relation(fields: [idPlano], references: [id])
  promocaoPlano      PromocaoPlano?      @relation(fields: [idPromocaoPlano], references: [id])
  motivoCancelamento MotivoCancelamento? @relation(fields: [idMotivoCancelamento], references: [id])
  pagamentos         Pagamento[]
  alunoCheckIns      AlunoCheckIn[]
  solicitacoes       SolicitacaoPlano[]

  @@index([idAluno])
  @@index([idPlano])
  @@index([idPromocaoPlano])
  @@index([idMotivoCancelamento])
  @@map("tb_AlunoPlanos")
}

model Pagamento {
  id                    Int       @id @default(autoincrement())
  idEmpresa             Int
  idAlunoPlano          Int?
  idProdutoMovimentacao Int?
  idStatusPagamento     Int
  idFormaPagamento      Int?
  // Por qual conta a cobranca foi (ou sera) emitida. Nulo = cobranca sem
  // integracao, que e como todo pagamento nasce hoje.
  idContaRecebimento    Int?
  // Id da transacao NO PROVEDOR. E o que torna a conciliacao possivel e o
  // webhook idempotente: gateway reenvia o mesmo evento por design, e sem uma
  // chave para reconhecer o repetido a mesma parcela recebe baixa duas vezes.
  caTransacaoExterna    String?   @db.VarChar(120)
  vlPrevisto            Decimal   @default(0) @db.Decimal(12, 4)
  vlPago                Decimal?  @db.Decimal(12, 4)
  dtCompetencia         DateTime? @db.Date
  dtVencimento          DateTime?
  dtPagamento           DateTime?
  dtCadastro            DateTime  @default(now())
  dtAlteracao           DateTime  @updatedAt
  idUsuarioCadastro     Int?
  idUsuarioAlteracao    Int?
  boInativo             Boolean   @default(false)

  empresa             Empresa              @relation(fields: [idEmpresa], references: [id])
  alunoPlano          AlunoPlano?          @relation(fields: [idAlunoPlano], references: [id])
  produtoMovimentacao ProdutoMovimentacao? @relation(fields: [idProdutoMovimentacao], references: [id])
  statusPagamento     StatusPagamento      @relation(fields: [idStatusPagamento], references: [id])
  formaPagamento      FormaPagamento?      @relation(fields: [idFormaPagamento], references: [id])
  contaRecebimento    ContaRecebimento?    @relation(fields: [idContaRecebimento], references: [id])
  webhookEventos      WebhookEvento[]

  // Uma transacao do provedor aponta para UM pagamento. E a trava que faz o
  // webhook repetido nao virar baixa duplicada. Nulos nao colidem no Postgres,
  // entao pagamento sem integracao segue livre.
  @@unique([idContaRecebimento, caTransacaoExterna])
  @@index([idAlunoPlano])
  @@index([idStatusPagamento, dtVencimento])
  @@index([idEmpresa])
  @@index([idProdutoMovimentacao])
  @@map("tb_Pagamentos")
}

