// Execucao de um exercicio numa sessao de treino.
//
// A SESSAO ja existe: e o AlunoCheckIn criado pelo "iniciar treino" (que carrega
// idAlunoTreinosSequencia). Falta so o que aconteceu dentro dela, que e esta
// tabela: quanto o aluno levantou de verdade, quantas series fez, se terminou.
//
// Uma linha por (sessao, exercicio prescrito) — o unique abaixo. Marcar a mesma
// serie de novo atualiza a linha em vez de empilhar duplicatas, que e o que
// acontece quando alguem toca duas vezes no botao.
model TreinoExecucao {
  id                 Int      @id @default(autoincrement())
  idAlunoCheckIn     Int
  idTreinoExercicio  Int
  // O que foi FEITO. O prescrito continua em TreinoExercicio; a diferenca entre
  // os dois e a informacao que o professor procura.
  nrSeriesFeitas     Int      @default(0)
  nrRepeticoes       Int      @default(0)
  vlCarga            Decimal? @db.Decimal(8, 2)
  idUnidadeMedida    Int?
  boConcluido        Boolean  @default(false)
  dsObservacao       String?  @db.VarChar(255)
  dtCadastro         DateTime @default(now())
  dtAlteracao        DateTime @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean  @default(false)

  alunoCheckIn    AlunoCheckIn    @relation(fields: [idAlunoCheckIn], references: [id])
  treinoExercicio TreinoExercicio @relation(fields: [idTreinoExercicio], references: [id])
  unidadeMedida   UnidadeMedida?  @relation(fields: [idUnidadeMedida], references: [id])

  @@unique([idAlunoCheckIn, idTreinoExercicio])
  @@index([idAlunoCheckIn])
  @@index([idTreinoExercicio])
  @@map("tb_TreinoExecucoes")
}

