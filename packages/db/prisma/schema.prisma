// Interessado que ainda nao e aluno.
//
// A porta de entrada da academia nao passava pelo sistema: quem via o site e
// queria treinar tinha que aparecer no balcao, e nada registrava que ele
// chegou a perguntar. Sem esta tabela nao existe a pergunta "quantos
// procuraram este mes e quantos viraram aluno" — o funil comeca cego.
//
// NAO e um Aluno incompleto de proposito: aluno tem CPF, plano, matricula e
// entra no calculo de acesso. Interessado tem nome e telefone. Misturar os
// dois faria a lista de alunos encher de gente que nunca pisou na academia.
model Lead {
  id            Int       @id @default(autoincrement())
  idCliente     Int
  // Filial de interesse. Nulo e comum: quem preenche o formulario do site nem
  // sempre sabe (ou se importa com) qual unidade.
  idEmpresa     Int?
  // Plano que despertou o interesse, quando ele veio de uma tela de planos.
  idPlano       Int?
  nmLead        String    @default("") @db.VarChar(255)
  nrDDD         Int?
  nrContato     String?   @db.VarChar(9)
  anEmail       String    @default("") @db.VarChar(100)
  dsMensagem    String?   @db.VarChar(500)
  // 'novo' | 'em_contato' | 'convertido' | 'perdido' — estados de codigo, pelo
  // mesmo motivo de Notificacao.cnTipo: quem os consome e a regra, nao o
  // operador.
  cnStatus      String    @default("novo") @db.VarChar(20)
  // 'site' | 'balcao' — de onde a pessoa chegou.
  caOrigem      String    @default("site") @db.VarChar(20)
  dsObservacao  String?   @db.VarChar(500)
  // Preenchido quando o interessado vira aluno de fato. E o que fecha o funil:
  // sem ele, 'convertido' seria so uma palavra sem ninguem do outro lado.
  idAluno       Int?
  idFuncionario Int?
  dtContato     DateTime?
  dtCadastro    DateTime  @default(now())
  dtAlteracao   DateTime  @updatedAt
  boInativo     Boolean   @default(false)

  cliente     Cliente      @relation(fields: [idCliente], references: [id])
  empresa     Empresa?     @relation(fields: [idEmpresa], references: [id])
  plano       Plano?       @relation(fields: [idPlano], references: [id])
  aluno       Aluno?       @relation(fields: [idAluno], references: [id])
  funcionario Funcionario? @relation(fields: [idFuncionario], references: [id])

  @@index([idCliente, cnStatus])
  @@index([idEmpresa])
  @@map("tb_Leads")
}

// Batida de ponto do funcionario.
//
// Uma LINHA POR BATIDA, nao uma linha por dia com entrada e saida: quem sai
// para almocar bate quatro vezes, e o par fixo por dia obrigaria a inventar
// colunas ate acabar a imaginacao. O espelho do mes emparelha as batidas na
// ordem.
//
// REGISTRA O FATO, NAO JULGA: nao ha atraso, hora extra nem falta aqui —
// julgar exige escala e tolerancia, que sao regras de contrato de cada
// academia e nao existem no sistema. O total de horas do dia sai do
// emparelhamento; o que ele significa e com o gerente.
model FuncionarioPonto {
  id                 Int      @id @default(autoincrement())
  idFuncionario      Int
  idEmpresa          Int?
  // 'entrada' | 'saida'. O servidor decide alternando a partir da ultima
  // batida do dia — deixar o cliente escolher produziria duas entradas
  // seguidas no primeiro clique duplo.
  cnTipo             String   @db.VarChar(10)
  dtRegistro         DateTime @default(now())
  // Batida lancada pelo gerente para corrigir esquecimento. A observacao e
  // obrigatoria nesse caso: uma correcao sem justificativa e indistinguivel
  // de adulteracao.
  boManual           Boolean  @default(false)
  dsObservacao       String?  @db.VarChar(255)
  dtCadastro         DateTime @default(now())
  dtAlteracao        DateTime @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean  @default(false)

  funcionario Funcionario @relation(fields: [idFuncionario], references: [id])
  empresa     Empresa?    @relation(fields: [idEmpresa], references: [id])

  @@index([idFuncionario, dtRegistro])
  @@index([idEmpresa])
  @@map("tb_FuncionarioPontos")
}

// Aparelho registrado para receber notificacao push.
//
// Pertence ao USUARIO e nao ao aluno porque quem se autentica e o usuario — e
// o mesmo aparelho pode hospedar contas diferentes ao longo do tempo. O unique
// no token e o que trata essa troca: registrar de novo MOVE o aparelho para o
// usuario atual em vez de duplicar, evitando que o dono anterior continue
// recebendo os avisos de quem usa o telefone agora.
model UsuarioDispositivo {
  id           Int      @id @default(autoincrement())
  idUsuario    Int
  // Token do Expo (ExponentPushToken[...]). E o endereco do aparelho; sem ele
  // nao ha para onde enviar.
  caTokenPush  String   @unique @db.VarChar(255)
  dsPlataforma String   @default("") @db.VarChar(20)
  dtUltimoUso  DateTime @default(now())
  dtCadastro   DateTime @default(now())
  dtAlteracao  DateTime @updatedAt
  boInativo    Boolean  @default(false)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([idUsuario])
  @@map("tb_UsuarioDispositivos")
}

// Por onde a academia RECEBE o dinheiro do aluno.
//
// A conta e do CLIENTE, nao nossa: o dinheiro vai direto da mao do aluno para a
// conta da academia, e o SmartGym so faz a ponte. Isso e deliberado e nao e
// detalhe de implementacao — manter o dinheiro fora do nosso fluxo evita virar
// intermediario financeiro, com o repasse e o risco regulatorio que isso traz.
//
// NAO CONFUNDIR COM FormaPagamento: aquela e lookup global e diz COMO o dinheiro
// entrou (dinheiro, cartao, pix). Esta diz POR ONDE — qual conta ou integracao
// recebeu. As duas convivem no mesmo Pagamento.
//
// ESCOPO: `idEmpresa` nulo vale para a rede inteira do cliente; preenchido,
// vale so para aquela filial. No Brasil a conta que recebe esta amarrada a um
// CNPJ, e cada Empresa tem o seu — quem centraliza cadastra uma linha, quem tem
// CNPJ por unidade cadastra uma por unidade.
model ContaRecebimento {
  id        Int  @id @default(autoincrement())
  idCliente Int
  idEmpresa Int?

  // Nome que o operador reconhece na tela ("Pix da matriz", "Asaas producao").
  dsConta String @db.VarChar(120)

  // 'pix_manual' | 'asaas' | 'mercadopago' — codigo, nao lookup: quem o consome
  // e a regra de integracao, que e versionada junto. Ver Notificacao.cnTipo.
  cnProvedor String @default("pix_manual") @db.VarChar(20)
  // 'sandbox' | 'producao'. Existe para a academia testar sem mover dinheiro de
  // verdade, e para a tela conseguir avisar quando alguem esqueceu em sandbox.
  cnAmbiente String @default("producao") @db.VarChar(10)

  // --- Pix ------------------------------------------------------------------
  // CRIPTOGRAFADA (prefixo enc:v1:, subchave propria — ver shared/secrets.ts).
  // A chave Pix "e publica" no sentido de que voce a entrega para receber, mas
  // ela pode SER um CPF ou um telefone. Guardar em claro abriria um buraco na
  // mesma politica que cifra CPF em todo o resto do sistema.
  caChavePix     String? @db.VarChar(400)
  // 'cpf' | 'cnpj' | 'email' | 'telefone' | 'aleatoria'. Guardado porque o
  // codigo Pix (padrao EMV do BC) valida a chave conforme o tipo, e porque a
  // tela mascara de forma diferente cada um.
  cnTipoChavePix String? @db.VarChar(12)
  // Exigidos pelo padrao EMV do Banco Central no codigo copia-e-cola. Sem eles
  // a conta esta cadastrada mas nao gera cobranca — entao pertencem a conta,
  // nao ao momento da emissao.
  nmBeneficiario String? @db.VarChar(25)
  dsCidade       String? @db.VarChar(15)

  // --- Gateway --------------------------------------------------------------
  // CRIPTOGRAFADA. Credencial ao portador: quem a tem le a carteira do cliente
  // e, conforme o escopo, movimenta dinheiro. NUNCA e devolvida por rota de
  // leitura — a API responde so os ultimos digitos.
  caCredencial String? @db.VarChar(600)

  // Endereco secreto do webhook desta conta: entra na URL que o provedor
  // chama (/webhooks/payments/<token>). Serve para DUAS coisas — descobrir de
  // qual academia e o evento, sem confiar no corpo, e ser o primeiro filtro:
  // sem o token o request nem chega ao processamento. Sorteado; trocar o valor
  // invalida a URL antiga, que e o remedio para vazamento.
  caTokenWebhook String? @unique @db.VarChar(64)

  // Conta usada por padrao ao emitir cobranca nova. Mesmo idioma de
  // Pontuacao.boPadrao: uma por escopo, garantida no handler.
  boPadrao Boolean @default(false)

  dtCadastro         DateTime @default(now())
  dtAlteracao        DateTime @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean  @default(false)

  cliente     Cliente           @relation(fields: [idCliente], references: [id])
  empresa     Empresa?          @relation(fields: [idEmpresa], references: [id])
  pagamentos  Pagamento[]
  eventos     WebhookEvento[]
  integracoes AlunoIntegracao[]

  @@index([idCliente])
  @@index([idEmpresa])
  @@map("tb_ContasRecebimento")
}

// Evento recebido de um provedor de pagamento (webhook).
//
// POR QUE GUARDAR O PAYLOAD CRU: sem isto, "o pagamento nao deu baixa" e uma
// pergunta sem resposta possivel — e alguem vai fazer essa pergunta. Com o
// evento gravado da forma como chegou da para dizer se ele chegou, se foi
// recusado e por que.
//
// APPEND-ONLY. Um evento e um fato que aconteceu; reprocessar gera linha nova.
model WebhookEvento {
  id                 Int       @id @default(autoincrement())
  idContaRecebimento Int
  // 'asaas' | 'mercadopago' — de onde veio, para o parser certo ser escolhido.
  cnProvedor         String    @db.VarChar(20)
  // Id do evento NO PROVEDOR. Chave de deduplicacao: provedor reenvia o mesmo
  // evento por design (timeout, retry), e sem isto o reenvio seria reprocessado.
  caEventoExterno    String?   @db.VarChar(120)
  cnTipoEvento       String    @default("") @db.VarChar(60)
  // Id da transacao no provedor, que liga o evento ao nosso Pagamento.
  caTransacaoExterna String?   @db.VarChar(120)
  // 'recebido' | 'processado' | 'ignorado' | 'recusado'.
  //  recebido  = gravado, ainda nao concluido (ex.: falta confirmar no provedor)
  //  processado= deu baixa
  //  ignorado  = evento que nao nos interessa (cobranca criada, por exemplo)
  //  recusado  = chegou, mas nao confere (valor menor, cobranca inexistente)
  cnStatus           String    @default("recebido") @db.VarChar(20)
  dsResultado        String?   @db.VarChar(400)
  // O corpo como chegou. Truncado no limite da coluna — o que interessa esta
  // sempre no comeco do JSON dos provedores.
  dsPayload          String?   @db.VarChar(4000)
  idPagamento        Int?
  dtProcessamento    DateTime?
  dtCadastro         DateTime  @default(now())

  contaRecebimento ContaRecebimento @relation(fields: [idContaRecebimento], references: [id], onDelete: Cascade)
  pagamento        Pagamento?       @relation(fields: [idPagamento], references: [id])

  // Mesmo evento so entra uma vez por conta.
  @@unique([idContaRecebimento, caEventoExterno])
  @@index([idContaRecebimento, dtCadastro])
  @@index([caTransacaoExterna])
  @@map("tb_WebhookEventos")
}

// Quem o aluno E dentro do provedor de pagamento.
//
// O Asaas (como qualquer PSP) exige um "cliente" cadastrado antes de emitir
// cobranca — com nome e CPF, porque a lei brasileira exige identificar quem
// paga. Este e o de-para entre o nosso Aluno e o cadastro la.
//
// TABELA E NAO COLUNA em Aluno de proposito: a academia pode ter mais de uma
// conta de recebimento (filiais com CNPJ proprio), e o mesmo aluno vira um
// cliente diferente em cada uma. Uma coluna so guardaria o ultimo.
model AlunoIntegracao {
  id                 Int      @id @default(autoincrement())
  idAluno            Int
  idContaRecebimento Int
  // Id do cliente no provedor.
  caClienteExterno   String   @db.VarChar(120)
  dtCadastro         DateTime @default(now())
  dtAlteracao        DateTime @updatedAt

  aluno            Aluno            @relation(fields: [idAluno], references: [id])
  contaRecebimento ContaRecebimento @relation(fields: [idContaRecebimento], references: [id], onDelete: Cascade)

  @@unique([idAluno, idContaRecebimento])
  @@index([idContaRecebimento])
  @@map("tb_AlunoIntegracoes")
}
