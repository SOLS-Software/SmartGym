// EXTRATO de pontos do aluno: uma linha por lancamento, nao um saldo mutavel.
//
// Mesmo idioma de ProdutoMovimentacao, que o projeto ja usa para estoque:
// `qtPontos` e o MOVIMENTO (positivo = ganhou, negativo = resgatou) e
// `qtDisponivel` e o SALDO DEPOIS dele. Guardar so o saldo tornaria impossivel
// responder "por que eu tenho 40 pontos?" — e essa e a primeira pergunta que o
// aluno faz. O saldo corrente e o qtDisponivel do lancamento mais recente.
model AlunoPontuacao {
  id                    Int      @id @default(autoincrement())
  idEmpresa             Int
  // Regra de ganho que originou o credito. NULO em resgate e em baixa avulsa,
  // que nao vem de regra nenhuma.
  idPontuacao           Int?
  idAluno               Int
  // De onde veio o lancamento. Os tres sao opcionais e mutuamente exclusivos na
  // pratica; servem para a linha do extrato saber se explicar sozinha.
  idAlunoCheckIn        Int?     @unique
  idProdutoMovimentacao Int?
  dsHistorico           String?  @db.VarChar(255)
  qtPontos              Int      @default(0)
  qtDisponivel          Int      @default(0)
  dtCadastro            DateTime @default(now())
  dtAlteracao           DateTime @updatedAt
  idUsuarioCadastro     Int?
  idUsuarioAlteracao    Int?
  boInativo             Boolean  @default(false)

  empresa             Empresa              @relation(fields: [idEmpresa], references: [id])
  pontuacao           Pontuacao?           @relation(fields: [idPontuacao], references: [id])
  aluno               Aluno                @relation(fields: [idAluno], references: [id])
  // Unico por check-in: o credito automatico nunca conta a mesma entrada duas
  // vezes, mesmo se a rota for chamada de novo.
  alunoCheckIn        AlunoCheckIn?        @relation(fields: [idAlunoCheckIn], references: [id])
  produtoMovimentacao ProdutoMovimentacao? @relation(fields: [idProdutoMovimentacao], references: [id])

  @@index([idEmpresa])
  @@index([idPontuacao])
  @@index([idAluno])
  @@index([idProdutoMovimentacao])
  @@map("tb_AlunoPontuacoes")
}

