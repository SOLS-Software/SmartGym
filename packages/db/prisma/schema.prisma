generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // Required for the extensions block
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model Empresa {
  id                 Int                                   @id @default(autoincrement())
  idTema             Int?
  dsEmpresa          String                                @db.VarChar(255)
  caCNPJ             String                                @unique @db.VarChar(14)
  anCEP              String?                               @db.VarChar(8)
  anLogradouro       String?                               @db.VarChar(150)
  nrEndereco         String?                               @db.VarChar(10)
  anBairro           String?                               @db.VarChar(100)
  anCidade           String?                               @db.VarChar(100)
  anUF               String?                               @db.VarChar(2)
  nrDDD              Int?
  nrContato          String?                               @db.VarChar(11)
  geoEmpresa         Unsupported("geometry(Point, 4326)")?
  dtCadastro         DateTime                              @default(now())
  dtAlteracao        DateTime                              @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean                               @default(false)

  pontuacoes                  Pontuacao[]
  atividades                  Atividade[]
  atividadeAgendas            AtividadeAgenda[]
  alunoAtividadeAgendas       AlunoAtividadeAgenda[]
  exercicios                  Exercicio[]
  produtos                    Produto[]
  treinos                     Treino[]
  esportes                    Esporte[]
  categorias                  Categoria[]
  promocoes                   Promocao[]
  planoAtividades             PlanoAtividade[]
  planoProdutos               PlanoProduto[]
  planoEmpresas               PlanoEmpresa[]
  planoValores                PlanoValor[]
  promocaoPlanos              PromocaoPlano[]
  promocaoProdutos            PromocaoProduto[]
  pagamentos                  Pagamento[]
  treinoExercicios            TreinoExercicio[]
  alunosPontuacoes            AlunoPontuacao[]
  produtoMovimentacoes        ProdutoMovimentacao[]
  empresaArquivos             EmpresaArquivo[]
  alunoCheckIns               AlunoCheckIn[]
  funcionarios                Funcionario[]
  funcionarioAtividadeAgendas FuncionarioAtividadeAgenda[]
  catracas                    Catraca[]
  localidades                 Localidade[]
  leads                       Lead[]
  funcionarioPontos           FuncionarioPonto[]
  contasRecebimento           ContaRecebimento[]
  idCliente                   Int
  tema                        Tema?                        @relation(fields: [idTema], references: [id])
  cliente                     Cliente                      @relation(fields: [idCliente], references: [id])
  temaCustomizado             TemaCustomizado?

  @@index([geoEmpresa], name: "geo_empresa", type: Gist)
  @@index([idCliente])
  @@map("tb_Empresas")
}

model Plano {
  id                 Int      @id @default(autoincrement())
  dsPlano            String   @db.VarChar(255)
  idFrequencia       Int?
  dtCadastro         DateTime @default(now())
  dtAlteracao        DateTime @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean  @default(false)

  frequencia      Frequencia?        @relation(fields: [idFrequencia], references: [id])
  planoAtividades PlanoAtividade[]
  planoProdutos   PlanoProduto[]
  planoEmpresas   PlanoEmpresa[]
  planoValores    PlanoValor[]
  promocaoPlanos  PromocaoPlano[]
  alunoPlanos     AlunoPlano[]
  leads           Lead[]
  solicitacoes    SolicitacaoPlano[]

  @@map("tb_Planos")
}

// Catalogo de regras de pontuacao da empresa: "quanto vale" cada coisa.
model Pontuacao {
  id                 Int      @id @default(autoincrement())
  idEmpresa          Int
  dsPontuacao        String   @db.VarChar(255)
  qtPontos           Int      @default(0)
  // Regra que credita SOZINHA a cada check-in do aluno. No maximo uma por
  // empresa (garantido no handler, nao no banco: e regra de negocio, e um
  // indice unico parcial nao e expressavel no schema do Prisma). Sem uma regra
  // padrao a fidelidade continua so no lancamento manual — que foi exatamente
  // o motivo de o saldo nunca ter saido do zero.
  boPadrao           Boolean  @default(false)
  dtCadastro         DateTime @default(now())
  dtAlteracao        DateTime @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean  @default(false)

  empresa          Empresa          @relation(fields: [idEmpresa], references: [id])
  alunosPontuacoes AlunoPontuacao[]
  alunoCheckIns    AlunoCheckIn[]

  @@index([idEmpresa])
  @@map("tb_Pontuacoes")
}

model Atividade {
  id                 Int      @id @default(autoincrement())
  idEmpresa          Int?
  idEsporte          Int?
  dsAtividade        String   @db.VarChar(255)
  dtCadastro         DateTime @default(now())
  dtAlteracao        DateTime @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean  @default(false)

  empresa          Empresa?          @relation(fields: [idEmpresa], references: [id])
  esporte          Esporte?          @relation(fields: [idEsporte], references: [id])
  atividadeAgendas AtividadeAgenda[]
  planoAtividades  PlanoAtividade[]

  @@index([idEmpresa])
  @@index([idEsporte])
  @@map("tb_Atividades")
}

model AtividadeAgenda {
  id                 Int       @id @default(autoincrement())
  idEmpresa          Int
  idAtividade        Int
  idCategoria        Int?
  idLocalidade       Int?
  dtInicial          DateTime?
  dtFinal            DateTime?
  qtAlunos           Int?
  dtCadastro         DateTime  @default(now())
  dtAlteracao        DateTime  @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean   @default(false)

  empresa                     Empresa                      @relation(fields: [idEmpresa], references: [id])
  atividade                   Atividade                    @relation(fields: [idAtividade], references: [id])
  categoria                   Categoria?                   @relation(fields: [idCategoria], references: [id])
  localidade                  Localidade?                  @relation(fields: [idLocalidade], references: [id])
  alunoAtividadeAgendas       AlunoAtividadeAgenda[]
  funcionarioAtividadeAgendas FuncionarioAtividadeAgenda[]
  alunoCheckIns               AlunoCheckIn[]

  @@index([idEmpresa])
  @@index([idAtividade])
  @@index([idCategoria])
  @@index([idLocalidade])
  @@map("tb_AtividadeAgendas")
}

model AlunoAtividadeAgenda {
  id                Int      @id @default(autoincrement())
  idEmpresa         Int
  idAtividadeAgenda Int
  idAluno           Int
  dtCadastro        DateTime @default(now())
  dtAlteracao       DateTime @updatedAt
  boInativo         Boolean  @default(false)

  empresa         Empresa         @relation(fields: [idEmpresa], references: [id])
  atividadeAgenda AtividadeAgenda @relation(fields: [idAtividadeAgenda], references: [id])
  aluno           Aluno           @relation(fields: [idAluno], references: [id])

  @@index([idEmpresa])
  @@index([idAtividadeAgenda])
  @@index([idAluno])
  @@map("tb_AlunoAtividadeAgendas")
}

model FuncionarioAtividadeAgenda {
  id                Int      @id @default(autoincrement())
  idEmpresa         Int
  idAtividadeAgenda Int
  idFuncionario     Int
  dtCadastro        DateTime @default(now())
  dtAlteracao       DateTime @updatedAt
  boInativo         Boolean  @default(false)

  empresa         Empresa         @relation(fields: [idEmpresa], references: [id])
  atividadeAgenda AtividadeAgenda @relation(fields: [idAtividadeAgenda], references: [id])
  funcionario     Funcionario     @relation(fields: [idFuncionario], references: [id])

  @@index([idEmpresa])
  @@index([idAtividadeAgenda])
  @@index([idFuncionario])
  @@map("tb_FuncionarioAtividadeAgendas")
}

model Exercicio {
  id                 Int      @id @default(autoincrement())
  idEmpresa          Int?
  dsExercicio        String   @db.VarChar(255)
  dsInstrucao        String?  @db.Text
  dtCadastro         DateTime @default(now())
  dtAlteracao        DateTime @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean  @default(false)

  empresa              Empresa?                @relation(fields: [idEmpresa], references: [id])
  exercicioEquipamento ExercicioEquipamento[]
  treinoExercicios     TreinoExercicio[]
  exercicioArquivos    ExercicioArquivo[]
  exercicioAreas       ExercicioAreaCorporal[]

  @@index([idEmpresa])
  @@map("tb_Exercicios")
}

model AreaCorporal {
  id             Int      @id @default(autoincrement())
  dsAreaCorporal String   @db.VarChar(100)
  dtCadastro     DateTime @default(now())
  dtAlteracao    DateTime @updatedAt
  boInativo      Boolean  @default(false)

  exercicioAreas ExercicioAreaCorporal[]

  @@map("tb_AreasCorporais")
}

model ExercicioAreaCorporal {
  id             Int      @id @default(autoincrement())
  idExercicio    Int
  idAreaCorporal Int
  dtCadastro     DateTime @default(now())
  dtAlteracao    DateTime @updatedAt
  boInativo      Boolean  @default(false)

  exercicio    Exercicio    @relation(fields: [idExercicio], references: [id])
  areaCorporal AreaCorporal @relation(fields: [idAreaCorporal], references: [id])

  @@index([idExercicio])
  @@index([idAreaCorporal])
  @@map("tb_ExercicioAreasCorporais")
}

model Produto {
  id                 Int      @id @default(autoincrement())
  idEmpresa          Int?
  dsProduto          String   @db.VarChar(255)
  qtEstoque          Int      @default(0)
  // Preco sugerido da venda no balcao. O valor efetivo continua sendo gravado
  // em ProdutoMovimentacao.vlUnitario (o operador pode mudar na hora); esta
  // coluna existe para a tela preencher sozinha em vez de exigir digitacao a
  // cada venda.
  vlVenda            Decimal? @db.Decimal(12, 4)
  // Preco em PONTOS. Nulo = produto nao resgatavel por fidelidade.
  qtPontosResgate    Int?
  dtCadastro         DateTime @default(now())
  dtAlteracao        DateTime @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean  @default(false)

  empresa              Empresa?              @relation(fields: [idEmpresa], references: [id])
  planoProdutos        PlanoProduto[]
  promocaoProdutos     PromocaoProduto[]
  produtoMovimentacoes ProdutoMovimentacao[]
  produtoArquivos      ProdutoArquivo[]

  @@index([idEmpresa])
  @@map("tb_Produtos")
}

model Treino {
  id                 Int      @id @default(autoincrement())
  idEmpresa          Int?
  idAluno            Int?
  idNivel            Int?
  dsTreino           String   @db.VarChar(255)
  dtCadastro         DateTime @default(now())
  dtAlteracao        DateTime @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean  @default(false)

  empresa          Empresa?          @relation(fields: [idEmpresa], references: [id])
  aluno            Aluno?            @relation(fields: [idAluno], references: [id])
  nivel            Nivel?            @relation(fields: [idNivel], references: [id])
  treinoExercicios TreinoExercicio[]
  alunoTreinos     AlunoTreino[]

  @@index([idEmpresa])
  @@index([idAluno])
  @@map("tb_Treinos")
}

model Esporte {
  id                 Int      @id @default(autoincrement())
  idEmpresa          Int?
  dsEsporte          String   @db.VarChar(255)
  dtCadastro         DateTime @default(now())
  dtAlteracao        DateTime @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean  @default(false)

  empresa    Empresa?    @relation(fields: [idEmpresa], references: [id])
  atividades Atividade[]
  categorias Categoria[]

  @@index([idEmpresa])
  @@map("tb_Esportes")
}

model Categoria {
  id                 Int      @id @default(autoincrement())
  idEmpresa          Int?
  idEsporte          Int?
  dsCategoria        String   @db.VarChar(255)
  dtCadastro         DateTime @default(now())
  dtAlteracao        DateTime @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean  @default(false)

  empresa          Empresa?          @relation(fields: [idEmpresa], references: [id])
  esporte          Esporte?          @relation(fields: [idEsporte], references: [id])
  atividadeAgendas AtividadeAgenda[]

  @@index([idEmpresa])
  @@index([idEsporte])
  @@map("tb_Categorias")
}

model Aluno {
  id                 Int       @id @default(autoincrement())
  nmAluno            String    @default("") @db.VarChar(255)
  // PII: valor criptografado (AES-256-GCM, prefixo enc:v1:). Lookups usam caCPFHash.
  caCPF              String    @default("") @db.VarChar(160)
  // HMAC-SHA256 do CPF normalizado — busca exata e unicidade sem expor o valor.
  caCPFHash          String?   @db.VarChar(64)
  dtNascimento       DateTime? @db.Date
  nrDDD              Int       @default(0)
  nrContato          String?   @db.VarChar(9)
  anEmail            String    @default("") @db.VarChar(100)
  anCEP              String    @default("") @db.VarChar(8)
  anLogradouro       String    @default("") @db.VarChar(150)
  anComplemento      String    @default("") @db.VarChar(100)
  anBairro           String    @default("") @db.VarChar(100)
  nrEndereco         String?   @db.VarChar(10)
  idCliente          Int
  // Id do usuario correspondente NO EQUIPAMENTO (Control iD). E o numero que a
  // catraca reporta em `user_id` ao liberar o acesso; sem ele o evento chega
  // como "usuario 1000013 entrou" e nao ha como dizer QUEM entrou.
  nrUsuarioCatraca   Int?
  dtCadastro         DateTime  @default(now())
  dtAlteracao        DateTime  @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean   @default(false)

  alunoEvolucoes        AlunoEvolucao[]
  alunoPlanos           AlunoPlano[]
  treinos               Treino[]
  alunoTreinos          AlunoTreino[]
  alunoAtividadeAgendas AlunoAtividadeAgenda[]
  alunoCheckIns         AlunoCheckIn[]
  alunosPontuacoes      AlunoPontuacao[]
  produtoMovimentacoes  ProdutoMovimentacao[]
  alunoArquivos         AlunoArquivo[]
  usuarios              Usuario[]
  alunobiometriafacial  AlunoBiometriaFacial[]
  catracaEventos        CatracaEvento[]
  cliente               Cliente                @relation(fields: [idCliente], references: [id])
  notificacoes          Notificacao[]
  leads                 Lead[]
  solicitacoesPlano     SolicitacaoPlano[]
  integracoes           AlunoIntegracao[]

  @@unique([idCliente, caCPFHash])
  // Um numero de usuario da catraca so pode apontar para UM aluno dentro do
  // mesmo cliente — senao dois alunos disputam o mesmo acesso liberado.
  @@unique([idCliente, nrUsuarioCatraca])
  // Login/register-lookup/forgot-password buscam por CPF sem idCliente — o
  // unique composto (idCliente lider) nao cobre esse acesso.
  @@index([caCPFHash])
  @@map("tb_Alunos")
}

model Funcionario {
  id                 Int       @id @default(autoincrement())
  idEmpresa          Int?
  idCargo            Int?
  // Perfil de acesso ao sistema (o que ele PODE FAZER). Diferente de idCargo,
  // que e o cargo de RH (o que ele E na empresa) e nao tem efeito nenhum sobre
  // permissao. Nulo = funcionario sem perfil: o RBAC nega tudo fora do proprio
  // perfil, entao um funcionario novo nao nasce com acesso por descuido.
  idPerfilAcesso     Int?
  nmFuncionario      String    @default("") @db.VarChar(255)
  // PII: valor criptografado (AES-256-GCM, prefixo enc:v1:). Lookups usam caCPFHash.
  caCPF              String    @default("") @db.VarChar(160)
  caCPFHash          String?   @db.VarChar(64)
  dtNascimento       DateTime? @db.Date
  nrDDD              Int?
  nrContato          String?   @db.VarChar(9)
  anEmail            String    @default("") @db.VarChar(100)
  dtAdmissao         DateTime? @default(now())
  dtCadastro         DateTime  @default(now())
  dtAlteracao        DateTime  @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean   @default(false)

  empresa                     Empresa?                     @relation(fields: [idEmpresa], references: [id])
  cargo                       Cargo?                       @relation(fields: [idCargo], references: [id])
  perfilAcesso                PerfilAcesso?                @relation(fields: [idPerfilAcesso], references: [id])
  usuarios                    Usuario[]
  alunoTreinos                AlunoTreino[]
  alunoEvolucoes              AlunoEvolucao[]
  funcionarioArquivos         FuncionarioArquivo[]
  funcionarioAtividadeAgendas FuncionarioAtividadeAgenda[]
  solicitacoesResolvidas      SolicitacaoPlano[]
  leads                       Lead[]
  pontos                      FuncionarioPonto[]

  @@unique([idEmpresa, caCPFHash])
  // Mesmo racional do Aluno: lookups de auth por CPF sem idEmpresa.
  @@index([caCPFHash])
  @@index([idPerfilAcesso])
  @@map("tb_Funcionarios")
}

model FuncionarioArquivo {
  id              Int      @id @default(autoincrement())
  idFuncionario   Int
  idTiposArquivos Int?
  dsArquivo       String   @default("") @db.VarChar(255)
  anCaminho       String   @default("") @db.VarChar(255)
  cnChaveAcesso   Int?
  cnDistribuidor  Int?
  dtCadastro      DateTime @default(now())
  dtAlteracao     DateTime @updatedAt
  boInativo       Boolean  @default(false)

  funcionario Funcionario  @relation(fields: [idFuncionario], references: [id])
  tipoArquivo TipoArquivo? @relation(fields: [idTiposArquivos], references: [id])

  @@index([idFuncionario])
  @@map("tb_FuncionarioArquivos")
}

model Usuario {
  id                 Int       @id @default(autoincrement())
  idFuncionario      Int?
  idAluno            Int?
  dsLogin            String    @unique @default("") @db.VarChar(100)
  dtUltimoAcesso     DateTime?
  dtCadastro         DateTime  @default(now())
  dtAlteracao        DateTime  @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean   @default(false)
  // Operacao interna (SOLS): habilita acoes cross-tenant, ex. criar clientes.
  boSuperAdmin       Boolean   @default(false)
  // Versao de sessao para revogacao de JWT: cada token carrega o valor vigente
  // no momento da emissao (claim `tv`). Logout e redefinicao de senha
  // incrementam esta coluna, invalidando TODOS os tokens ja emitidos (o plugin
  // de auth compara a cada request). Sem isto, um JWT valido sobreviveria ao
  // logout / troca de senha ate expirar por tempo.
  nrTokenVersion     Int       @default(0)

  funcionario       Funcionario?         @relation(fields: [idFuncionario], references: [id])
  aluno             Aluno?               @relation(fields: [idAluno], references: [id])
  senhas            Senha[]
  recuperacoesSenha RecuperacaoSenha[]
  dispositivos      UsuarioDispositivo[]

  @@index([idFuncionario])
  @@index([idAluno])
  @@map("tb_Usuarios")
}

model Senha {
  id                 Int       @id @default(autoincrement())
  idUsuario          Int
  dsSenha            String?   @db.VarChar(255)
  cnTipoHash         Int?
  dtExpiracao        DateTime?
  boTrocaObrigatoria Boolean   @default(false)
  dtCadastro         DateTime  @default(now())
  dtAlteracao        DateTime  @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean   @default(false)

  usuario Usuario @relation(fields: [idUsuario], references: [id])

  @@index([idUsuario])
  @@map("tb_Senhas")
}

// Tokens de redefinicao de senha: single-use, com expiracao. Armazena apenas
// o SHA-256 do token — o valor real so trafega no link enviado por email.
model RecuperacaoSenha {
  id           Int       @id @default(autoincrement())
  idUsuario    Int
  dsTokenHash  String    @db.VarChar(64)
  dtExpiracao  DateTime
  dtUtilizacao DateTime?
  dtCadastro   DateTime  @default(now())

  usuario Usuario @relation(fields: [idUsuario], references: [id])

  @@index([dsTokenHash])
  @@index([idUsuario])
  @@map("tb_RecuperacoesSenha")
}

model Promocao {
  id                 Int       @id @default(autoincrement())
  idEmpresa          Int?
  dsPromocao         String    @default("") @db.VarChar(255)
  qtPeriodo          Int       @default(0)
  idUnidadeTempo     Int?
  vlDesconto         Decimal?  @default(0) @db.Decimal(12, 4)
  pcDesconto         Decimal?  @default(0) @db.Decimal(12, 4)
  dtInicio           DateTime? @default(now())
  dtEncerramento     DateTime?
  dtCadastro         DateTime  @default(now())
  dtAlteracao        DateTime  @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean   @default(false)

  empresa          Empresa?          @relation(fields: [idEmpresa], references: [id])
  unidadeTempo     UnidadeTempo?     @relation(fields: [idUnidadeTempo], references: [id])
  promocaoPlanos   PromocaoPlano[]
  promocaoProdutos PromocaoProduto[]
  promocaoArquivos PromocaoArquivo[]

  @@index([idEmpresa])
  @@map("tb_Promocoes")
}

model PlanoAtividade {
  id          Int      @id @default(autoincrement())
  idEmpresa   Int?
  idPlano     Int
  idAtividade Int
  dtCadastro  DateTime @default(now())
  dtAlteracao DateTime @updatedAt
  boInativo   Boolean  @default(false)

  empresa   Empresa?  @relation(fields: [idEmpresa], references: [id])
  plano     Plano     @relation(fields: [idPlano], references: [id])
  atividade Atividade @relation(fields: [idAtividade], references: [id])

  @@index([idEmpresa])
  @@index([idPlano])
  @@index([idAtividade])
  @@map("tb_PlanoAtividades")
}

model PlanoProduto {
  id          Int      @id @default(autoincrement())
  idEmpresa   Int?
  idPlano     Int
  idProduto   Int
  dtCadastro  DateTime @default(now())
  dtAlteracao DateTime @updatedAt
  boInativo   Boolean  @default(false)

  empresa Empresa? @relation(fields: [idEmpresa], references: [id])
  plano   Plano    @relation(fields: [idPlano], references: [id])
  produto Produto  @relation(fields: [idProduto], references: [id])

  @@index([idEmpresa])
  @@index([idPlano])
  @@index([idProduto])
  @@map("tb_PlanoProdutos")
}

model PlanoEmpresa {
  id          Int      @id @default(autoincrement())
  idEmpresa   Int
  idPlano     Int
  dtCadastro  DateTime @default(now())
  dtAlteracao DateTime @updatedAt
  boInativo   Boolean  @default(false)

  empresa Empresa @relation(fields: [idEmpresa], references: [id])
  plano   Plano   @relation(fields: [idPlano], references: [id])

  @@index([idEmpresa])
  @@index([idPlano])
  @@map("tb_PlanoEmpresas")
}

model PlanoValor {
  id                 Int      @id @default(autoincrement())
  idEmpresa          Int?
  idPlano            Int
  vlVenda            Decimal? @default(0) @db.Decimal(12, 4)
  dtCadastro         DateTime @default(now())
  dtAlteracao        DateTime @updatedAt
  idUsuarioCadastro  Int?
  idUsuarioAlteracao Int?
  boInativo          Boolean  @default(false)

  empresa Empresa? @relation(fields: [idEmpresa], references: [id])
  plano   Plano    @relation(fields: [idPlano], references: [id])

  @@index([idEmpresa])
  @@index([idPlano])
  @@map("tb_PlanoValores")
}

model PromocaoPlano {
  id             Int       @id @default(autoincrement())
