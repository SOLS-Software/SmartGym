model CatracaEvento {
  id                  Int      @id @default(autoincrement())
  idCatraca           Int
  // Aluno resolvido a partir de `nrUsuarioCatraca` no momento em que o evento
  // chegou (ver Aluno.nrUsuarioCatraca). Fica nulo quando o numero nao esta
  // vinculado a ninguem — acesso de funcionario, visitante ou vinculo pendente.
  idAluno             Int?
  idEventoDispositivo BigInt?
  nrUsuarioCatraca    String?  @db.VarChar(50)
  nrTipoEvento        Int?
  dsTipoEvento        String   @default("") @db.VarChar(50)
  boAcessoLiberado    Boolean  @default(false)
  dsIdentificacao     String   @default("") @db.VarChar(50)
  dsCartao            String   @default("") @db.VarChar(50)
  dsPortal            String   @default("") @db.VarChar(20)
  dsDirecao           String   @default("") @db.VarChar(20)
  anIpOrigem          String   @default("") @db.VarChar(45)
  // Motivo em pt-BR quando o SmartGym nega o acesso ("Pagamento em atraso.",
  // "Aluno nao possui plano ativo."). Vazio nos eventos vindos do log do
  // equipamento, que nao carregam justificativa.
  dsMotivo            String   @default("") @db.VarChar(200)
  // true = decisao tomada pelo SmartGym no modo online (a catraca perguntou e
  // nos respondemos). false = registro coletado do log do proprio equipamento.
  // Uma mesma passagem gera os dois: a decisao na hora e, depois, o log que a
  // catraca guardou. Esta flag e o que permite separar um do outro no relatorio
  // em vez de parecerem acessos duplicados.
  boDecisaoOnline     Boolean  @default(false)
  dtEvento            DateTime
  jsPayload           Json?
  dtCadastro          DateTime @default(now())

  catraca Catraca @relation(fields: [idCatraca], references: [id])
  aluno   Aluno?  @relation(fields: [idAluno], references: [id])

  // Um id de log do equipamento so pode existir uma vez por catraca. Sem isso,
  // dois ciclos de coleta em voo gravam o mesmo acesso duas vezes e inflam a
  // frequencia do aluno. NULL nao conflita: as decisoes tomadas pelo SmartGym
  // no modo online nao tem id de log do equipamento.
  @@unique([idCatraca, idEventoDispositivo])
  @@index([idCatraca, dtEvento])
  @@index([dtEvento])
  @@index([idAluno, dtEvento])
  @@map("tb_CatracaEventos")
}

