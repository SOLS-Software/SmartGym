  tipoCheckIn          TipoCheckIn?          @relation(fields: [idTipoCheckIn], references: [id])
  alunoPontuacao       AlunoPontuacao?
  execucoes            TreinoExecucao[]

  @@index([idAluno, idAtividadeAgenda])
  @@index([idEmpresa])
  @@index([idAlunoPlano])
  @@index([idAlunoTreinosSequencia])
  @@index([idAtividadeAgenda])
  @@index([idPontuacao])
  @@map("tb_AlunoCheckIns")
}

// Aviso destinado a um aluno. Existe como LINHA (e nao so calculado na hora)
// porque um aviso precisa de memoria: saber se ja foi lido, se ja foi enviado
// por email, e nao reaparecer como novidade a cada abertura da tela.
//
// `caChave` e a chave de deduplicacao: identifica O MESMO aviso ao longo do
// tempo (ex.: "pagamento_atrasado:412"). Sem ela, cada varredura criaria uma
// linha nova do mesmo assunto e o aluno veria a mesma cobranca sete vezes.
model Notificacao {
  id           Int       @id @default(autoincrement())
  idAluno      Int
  // Tipo e severidade sao strings de CODIGO, nao lookups: quem as consome e o
  // proprio codigo (regra de geracao e estilo da tela), nao o operador. Uma
  // tabela editavel aqui divergiria das regras no primeiro rename.
  cnTipo       String    @db.VarChar(40)
  cnSeveridade String    @default("info") @db.VarChar(20)
  dsTitulo     String    @default("") @db.VarChar(120)
  dsMensagem   String    @default("") @db.VarChar(500)
  caChave      String    @db.VarChar(120)
  dtLeitura    DateTime?
  // Quando o email saiu. Nulo = ainda nao enviado; e o que impede a varredura
  // de reenviar o mesmo aviso todo dia.
  dtEnvioEmail DateTime?
  // Quando o push saiu. Coluna separada do email de proposito: um aparelho sem
  // app instalado nao pode impedir o email de sair, nem o contrario.
  dtEnvioPush  DateTime?
  dtCadastro   DateTime  @default(now())
  dtAlteracao  DateTime  @updatedAt
  boInativo    Boolean   @default(false)

  aluno Aluno @relation(fields: [idAluno], references: [id])

  @@unique([idAluno, caChave])
  @@index([idAluno])
  @@index([dtEnvioEmail])
  @@map("tb_Notificacoes")
}

// Pedido do aluno para cancelar ou renovar a matricula.
//
// O aluno PEDE; a equipe resolve. Nao e cancelamento unilateral de proposito:
// aviso previo, multa e fidelidade contratual sao regras de cada academia, e
// nao existem no sistema — deixar o aluno encerrar sozinho aplicaria uma regra
// que ninguem definiu. Aprovar a solicitacao dispara o MESMO cancelamento que a
// equipe ja fazia pela ficha, com o motivo que o aluno informou.
model SolicitacaoPlano {
  id                     Int       @id @default(autoincrement())
  // NULAVEL: quem ainda nao tem matricula tambem pede plano ("quero este").
  // Cancelamento e renovacao sempre apontam para um plano existente; troca e
  // contratacao, nao.
  idAlunoPlano           Int?
  // Aluno dono do pedido. Redundante com alunoPlano.idAluno quando ha plano,
  // e a UNICA forma de saber de quem e o pedido quando nao ha.
  idAluno                Int?
  // Plano que o aluno QUER (troca ou contratacao). Nulo em cancelamento e em
  // renovacao, que repetem o plano atual.
  idPlanoDesejado        Int?
  // 'cancelamento' | 'renovacao' | 'troca' — estados de codigo, ver
  // Notificacao.cnTipo.
  cnTipo                 String    @db.VarChar(20)
  // 'pendente' | 'aprovada' | 'recusada'
  cnStatus               String    @default("pendente") @db.VarChar(20)
  idMotivoCancelamento   Int?
  dsObservacao           String?   @db.VarChar(500)
  dsResposta             String?   @db.VarChar(500)
  idFuncionarioResolucao Int?
  dtResolucao            DateTime?
  dtCadastro             DateTime  @default(now())
  dtAlteracao            DateTime  @updatedAt
  idUsuarioCadastro      Int?
  idUsuarioAlteracao     Int?
  boInativo              Boolean   @default(false)

  alunoPlano           AlunoPlano?         @relation(fields: [idAlunoPlano], references: [id])
  aluno                Aluno?              @relation(fields: [idAluno], references: [id])
  planoDesejado        Plano?              @relation(fields: [idPlanoDesejado], references: [id])
  motivoCancelamento   MotivoCancelamento? @relation(fields: [idMotivoCancelamento], references: [id])
  funcionarioResolucao Funcionario?        @relation(fields: [idFuncionarioResolucao], references: [id])

  @@index([idAluno])
  @@index([idAlunoPlano])
  @@index([cnStatus])
  @@map("tb_SolicitacoesPlano")
}

// Motivos de cancelamento de matricula. Tabela de dominio global, como
