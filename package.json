{
  "name": "solsfit",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @solsfit/db db:generate",
    "db:migrate": "pnpm --filter @solsfit/db db:migrate",
    "db:seed:demo": "pnpm --filter @solsfit/db db:seed:demo",
    "db:catalogo:export": "pnpm --filter @solsfit/db db:catalogo:export",
    "db:catalogo:seed": "pnpm --filter @solsfit/db db:catalogo:seed",
    "db:studio": "pnpm --filter @solsfit/db db:studio",
    "test": "turbo test"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.9.14",
    "typescript": "^5.7.2"
  }
}
