{
  "expo": {
    "name": "SOLSFIT",
    "slug": "solsfit",
    "scheme": "solsfit",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1f7a53"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1f7a53"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o SOLSFIT use a camera para anexar fotos ao cadastro do aluno."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o SOLSFIT use o Face ID para desbloquear sua sessao."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permitir que o SOLSFIT use o Face ID para proteger seus dados de acesso."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "br.com.solssoftwares.solsfit",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#1f7a53"
      }
    },
    "ios": {
      "bundleIdentifier": "br.com.solssoftwares.solsfit"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
